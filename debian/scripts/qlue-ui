#!/bin/sh

if [ ! -f ./config.yaml ]; then
    echo "config.yaml not found, copying default from /usr/share/qlue-ui/."
    cp /usr/share/qlue-ui/config.yaml ./config.yaml
fi

if [ ! -d ./examples ]; then
    echo "examples/ not found, copying from /usr/share/qlue-ui/examples."
    cp -r /usr/share/qlue-ui/examples ./examples
fi

export EXAMPLES_DIR=./examples
export CONFIG_PATH=./config.yaml
export DB_PATH=./shared-queries.db
export FRONTEND_DIR=/usr/share/qlue-ui/dist/
export API_KEY=change-me-on-install

case "$1" in
    dev)
        PORT="${2:-8176}"
        /opt/venvs/qlue-ui/bin/uvicorn api.main:app --host 0.0.0.0 --port "$PORT" --app-dir /opt/venvs/qlue-ui
        ;;
    *)
        echo "Usage: qlue-ui dev [port]" >&2
        exit 1
        ;;
esac
